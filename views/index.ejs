<html>
  <head>
    <title>Mini Message Board</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
  </h1><%= title %></h1>
  <% messages.forEach(message => { %>
    <p><%= message.text %></p>
    <p><%= message.user %></p>
    <p><% message.added %></p>
  <% }); %>
  </body>
</html>
