<html>
  <head>
    <title>Mini Message Board</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
  <h1><%= title %></h1>

  <a href="/new">Create a new message</a>

  <% messages.forEach((message, index) => { %>
    <div>
      <h2><%= message.user %></h2>
      <p><%= message.text %></p>
      <p><%= message.added %></p>

      <a href="/message/<%= index %>">Open</a>
    </div>
  <% }); %>
  </body>
</html>
